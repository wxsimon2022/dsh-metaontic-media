# 复制为 `.env` 后按需填写（勿把 `.env` 提交到版本库）

# ---------- 博客 MySQL（生产务必配置；服务端 MySQL 5.7+ 与 schema.sql 一致）----------
# 完整连接串（推荐）
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/personal_blog?charset=utf8mb4
# 与 Flask-SQLAlchemy 文档一致的可选别名
# SQLALCHEMY_DATABASE_URI=

# 或使用分项配置（未设置 DATABASE_URL 时由程序拼接）
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=personal_blog

# 未配置任何项时，程序仅使用本地开发默认库（见 blog_py/config.py），生产请勿依赖。

# ---------- 博客其它 ----------
SECRET_KEY=change-me-in-production
BLOG_ADMIN_PASSWORD=admin123
BLOG_ADMIN_EMAIL=admin@example.com
POSTS_PER_PAGE=10

# ---------- 服务监听（python -m blog_py 开发/直连运行）----------
# 端口优先读 BLOG_PORT，其次 PORT、FLASK_RUN_PORT，默认 5001
BLOG_PORT=5001
# BLOG_HOST=127.0.0.1
# 是否调试：未设置 BLOG_DEBUG 时仍看 FLASK_DEBUG（默认开）
# BLOG_DEBUG=0

# ---------- Redis（文章点赞排行 ZSET）----------
REDIS_URL=redis://127.0.0.1:6379/0
# 分项（未设置 REDIS_URL 时使用）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
# 文章点赞 ZSET 的 key（默认 b:post:likes）
# REDIS_BLOG_LIKES_KEY=b:post:likes
# 文章阅读数 HASH 的 key（默认 b:post:views）
# REDIS_BLOG_VIEWS_KEY=b:post:views


{
  "name": "dsh-metaontic-media",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "cordis.patch.yml",
    "docs/config.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "description": "MetaOntic Media：自然语言图片与视频生成、任务恢复和本地素材管理",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxsimon2022/dsh-metaontic-media.git"
  },
  "homepage": "https://github.com/wxsimon2022/dsh-metaontic-media#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
